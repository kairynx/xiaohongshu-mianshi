# 面经助手 - 环境变量配置
# 复制此文件为 .env 并修改对应配置

# MySQL 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=mianshi_app

# MCP 服务地址
MCP_URL=http://localhost:18060/mcp

# Cookies 文件路径
COOKIES_PATH=./docker-data/cookies/cookies.json

# Tesseract OCR 路径（Windows 示例: D:\\TesseractOCR\\tesseract.exe）
TESSERACT_PATH=tesseract

# ============ LLM（DeepSeek / OpenAI 兼容协议） ============
# DeepSeek: https://platform.deepseek.com/api_keys
# OpenAI:   LLM_BASE_URL=https://api.openai.com  LLM_MODEL=gpt-4o
# Ollama:   LLM_BASE_URL=http://localhost:11434  LLM_MODEL=qwen2.5
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60000

# ============ 开发调试 ============
# 设为 1 可在改 prompt 后无需重启服务（不缓存 prompt 文件）
# PROMPT_NO_CACHE=1
