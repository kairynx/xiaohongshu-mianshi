# 面经助手 - 环境变量配置
# 复制此文件为 .env 并修改对应配置

# MySQL 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=mianshi_app

# MCP 服务地址
MCP_URL=http://localhost:18060/mcp

# Cookies 文件路径
COOKIES_PATH=./docker-data/cookies/cookies.json

# Tesseract OCR 路径（Windows 示例: D:\\TesseractOCR\\tesseract.exe）
TESSERACT_PATH=tesseract
